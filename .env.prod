# Production environment for hrms.nanoit-solutions.com
# Cloudflare handles SSL termination — origin listens on HTTP port 80

ERPNEXT_VERSION=v16.16.0
CUSTOM_IMAGE=custom-erpnext
CUSTOM_TAG=16
PULL_POLICY=never

# Database password — change this before first deploy
DB_PASSWORD=

# Site name must match the hostname used in Cloudflare DNS
FRAPPE_SITE_NAME_HEADER=hrms.nanoit-solutions.com

# Expose HTTP on port 6767; Cloudflare proxies HTTPS -> HTTP to this port
HTTP_PUBLISH_PORT=6767

# Cloudflare forwards the real client IP in CF-Connecting-IP.
# X-Forwarded-For is also set by Cloudflare and is safe to use here.
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

# Increase if needed for large file uploads
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
